# than aspirational. Only the bulky binary artifacts below stay out.
results/profile/
*.nsys-rep
*.ncu-rep
*.sqlite
*.qdrep

__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

