# Keep folder structure traversable
!*/
# Keep repository meta files
!.gitignore
!.gitattributes
# Explicitly ignore common LaTeX build artifacts (redundant with '*' but kept for clarity)
*.pdf
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.xdv
*.dvi
*.ps
