\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{latex-screenshot}[2025/06/03 Compatibility shims for screenshot-to-latex fragments]
%
% This package provides all packages and commands that pandoc-generated
% LaTeX fragments may reference, so you can paste them directly into any
% document that loads this package without extra boilerplate.
%
% Usage:  \usepackage{latex-screenshot}
%
% Designed to complement annotation.sty but works independently.

% ===================================================================
% Packages required by pandoc's LaTeX table output
% ===================================================================

\RequirePackage{longtable}          % longtable environment
\RequirePackage{booktabs}           % \toprule, \midrule, \bottomrule
\RequirePackage{array}              % \arraybackslash, \raggedright in columns
\RequirePackage{calc}               % \real{...} in column-width expressions
\RequirePackage{etoolbox}           % \patchcmd for longtable fix

% Fix longtable after \paragraph or \subparagraph (from pandoc template)
\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\makeatother

% Allow footnotes inside longtable
\IfFileExists{footnotehyper.sty}{%
  \RequirePackage{footnotehyper}%
}{%
  \RequirePackage{footnote}%
}
\makesavenoteenv{longtable}

% Prevent overfull lines in pasted fragments
\setlength{\emergencystretch}{3em}

% ===================================================================
% Pandoc helper commands (safe \providecommand — no-op if already defined)
% ===================================================================

% \tightlist: tightens list spacing in itemize/enumerate
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% \passthrough: identity wrapper for inline code
\providecommand{\passthrough}[1]{#1}

% \pandocbounded: identity wrapper for bounded content
\providecommand{\pandocbounded}[1]{#1}

% \hypertarget: hyperref provides this; fallback if hyperref not loaded
\providecommand{\hypertarget}[2]{#2}

\endinput
